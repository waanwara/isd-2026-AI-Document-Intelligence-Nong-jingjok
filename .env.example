# ══════════════════════════════════════════════════════════════════════
# Jingjok-Thorius Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอก API Key ที่ถูกต้อง:
#   copy .example.env .env
# ══════════════════════════════════════════════════════════════════════

# Typhoon API Key (โมเดล LLM ภาษาไทย — สมัครฟรีที่ https://opentyphoon.ai)
# จำเป็นสำหรับคำถามเชิงวิเคราะห์ ("ได้ไหม/ทำไม") ถ้าไม่ใส่ ระบบยังตอบคำถามจากฐานข้อมูลได้
TYPHOON_API_KEY=your_typhoon_api_key_here

# ข้ามการโหลดโมเดล embedding ขนาดใหญ่ตอนเริ่มต้น เพื่อให้เปิดเซิร์ฟเวอร์ได้ทันที (1 = เปิดใช้งานข้าม warmup)
KATRAG_SKIP_WARMUP=1
